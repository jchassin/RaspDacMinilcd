/dts-v1/;
/plugin/;

/*
 * Audiophonics RaspDAC Mini - ILI9341
 * Raspberry Pi 4 / Raspberry Pi OS Trixie / DRM-KMS
 *
 * Wiring assumed:
 *   SPI bus : SPI0
 *   CS      : CE0 / GPIO8
 *   MOSI    : GPIO10
 *   SCLK    : GPIO11
 *   DC      : GPIO27
 *   RESET   : GPIO24
 *
 * Backlight is intentionally not controlled here.
 *
 * The in-kernel DRM tiny ILI9341 driver matches "adafruit,yx240qv29".
 * rotation = <90> gives a 320x240 logical landscape display.
 */

/ {
    compatible = "brcm,bcm2711";

    fragment@0 {
        target = <&spi0>;
        __overlay__ {
            status = "okay";

            #address-cells = <1>;
            #size-cells = <0>;

            raspdac_lcd: display@0 {
                compatible = "adafruit,yx240qv29", "ilitek,ili9341";
                reg = <0>;

                spi-max-frequency = <10000000>;

                dc-gpios = <&gpio 27 0>;
                reset-gpios = <&gpio 24 0>;

                rotation = <90>;

                status = "okay";
            };
        };
    };

    fragment@1 {
        target = <&spidev0>;
        __overlay__ {
            status = "disabled";
        };
    };

    __overrides__ {
        speed = <&raspdac_lcd>,"spi-max-frequency:0";
        rotate = <&raspdac_lcd>,"rotation:0";
    };
};

